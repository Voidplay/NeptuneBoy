<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.ClosingReviewMapper">
    
    <resultMap type="ClosingReview" id="ClosingReviewResult">
        <result property="id"    column="id"    />
        <result property="analysisId"    column="analysis_id"    />
        <result property="review"    column="review"    />
        <result property="createdAt"    column="created_at"    />
        <result property="updatedAt"    column="updated_at"    />
    </resultMap>

    <sql id="selectClosingReviewVo">
        select id, analysis_id, review, created_at, updated_at from closing_review
    </sql>

    <select id="selectClosingReviewList" parameterType="ClosingReview" resultMap="ClosingReviewResult">
        <include refid="selectClosingReviewVo"/>
        <where>  
            <if test="analysisId != null "> and analysis_id = #{analysisId}</if>
            <if test="review != null  and review != ''"> and review = #{review}</if>
            <if test="createdAt != null "> and created_at = #{createdAt}</if>
            <if test="updatedAt != null "> and updated_at = #{updatedAt}</if>
        </where>
    </select>
    
    <select id="selectClosingReviewById" parameterType="Long" resultMap="ClosingReviewResult">
        <include refid="selectClosingReviewVo"/>
        where id = #{id}
    </select>

    <insert id="insertClosingReview" parameterType="ClosingReview" useGeneratedKeys="true" keyProperty="id">
        insert into closing_review
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="analysisId != null">analysis_id,</if>
            <if test="review != null">review,</if>
            <if test="createdAt != null">created_at,</if>
            <if test="updatedAt != null">updated_at,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="analysisId != null">#{analysisId},</if>
            <if test="review != null">#{review},</if>
            <if test="createdAt != null">#{createdAt},</if>
            <if test="updatedAt != null">#{updatedAt},</if>
         </trim>
    </insert>

    <update id="updateClosingReview" parameterType="ClosingReview">
        update closing_review
        <trim prefix="SET" suffixOverrides=",">
            <if test="analysisId != null">analysis_id = #{analysisId},</if>
            <if test="review != null">review = #{review},</if>
            <if test="createdAt != null">created_at = #{createdAt},</if>
            <if test="updatedAt != null">updated_at = #{updatedAt},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteClosingReviewById" parameterType="Long">
        delete from closing_review where id = #{id}
    </delete>

    <delete id="deleteClosingReviewByIds" parameterType="String">
        delete from closing_review where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>