<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.OpeningReasonMapper">

    <resultMap type="OpeningReason" id="OpeningReasonResult">
        <result property="id"    column="id"    />
        <result property="positionId"    column="position_id"    />
        <result property="reason"    column="reason"    />
        <result property="createdAt"    column="created_at"    />
        <result property="updatedAt"    column="updated_at"    />
    </resultMap>

    <sql id="selectOpeningReasonVo">
        select id, position_id, reason, created_at, updated_at from opening_reason
    </sql>

    <select id="selectOpeningReasonList" parameterType="OpeningReason" resultMap="OpeningReasonResult">
        <include refid="selectOpeningReasonVo"/>
        <where>
            <if test="positionId != null "> and position_id = #{positionId}</if>
            <if test="reason != null  and reason != ''"> and reason = #{reason}</if>
            <if test="createdAt != null "> and created_at = #{createdAt}</if>
            <if test="updatedAt != null "> and updated_at = #{updatedAt}</if>
        </where>
    </select>

    <select id="selectOpeningReasonById" parameterType="Long" resultMap="OpeningReasonResult">
        <include refid="selectOpeningReasonVo"/>
        where id = #{id}
    </select>

    <insert id="insertOpeningReason" parameterType="OpeningReason" useGeneratedKeys="true" keyProperty="id">
        insert into opening_reason
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="positionId != null">position_id,</if>
            <if test="reason != null">reason,</if>
            <if test="createdAt != null">created_at,</if>
            <if test="updatedAt != null">updated_at,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="positionId != null">#{positionId},</if>
            <if test="reason != null">#{reason},</if>
            <if test="createdAt != null">#{createdAt},</if>
            <if test="updatedAt != null">#{updatedAt},</if>
        </trim>
    </insert>

    <update id="updateOpeningReason" parameterType="OpeningReason">
        update opening_reason
        <trim prefix="SET" suffixOverrides=",">
            <if test="positionId != null">position_id = #{positionId},</if>
            <if test="reason != null">reason = #{reason},</if>
            <if test="createdAt != null">created_at = #{createdAt},</if>
            <if test="updatedAt != null">updated_at = #{updatedAt},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteOpeningReasonById" parameterType="Long">
        delete from opening_reason where id = #{id}
    </delete>

    <delete id="deleteOpeningReasonByIds" parameterType="String">
        delete from opening_reason where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <select id="selectOpeningReasonByPositionId" resultType="com.ruoyi.system.domain.OpeningReason">
        SELECT * FROM opening_reason WHERE position_id = #{positionId} LIMIT 1
    </select>


</mapper>