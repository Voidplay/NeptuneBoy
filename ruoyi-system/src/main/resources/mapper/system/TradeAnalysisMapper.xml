<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.TradeAnalysisMapper">
    
    <resultMap type="TradeAnalysis" id="TradeAnalysisResult">
        <result property="id"    column="id"    />
        <result property="positionId"    column="position_id"    />
        <result property="createdAt"    column="created_at"    />
        <result property="updatedAt"    column="updated_at"    />
    </resultMap>

    <sql id="selectTradeAnalysisVo">
        select id, position_id, created_at, updated_at from trade_analysis
    </sql>

    <select id="selectTradeAnalysisList" parameterType="TradeAnalysis" resultMap="TradeAnalysisResult">
        <include refid="selectTradeAnalysisVo"/>
        <where>  
            <if test="positionId != null "> and position_id = #{positionId}</if>
            <if test="createdAt != null "> and created_at = #{createdAt}</if>
            <if test="updatedAt != null "> and updated_at = #{updatedAt}</if>
        </where>
    </select>
    
    <select id="selectTradeAnalysisById" parameterType="Long" resultMap="TradeAnalysisResult">
        <include refid="selectTradeAnalysisVo"/>
        where id = #{id}
    </select>

    <insert id="insertTradeAnalysis" parameterType="TradeAnalysis" useGeneratedKeys="true" keyProperty="id">
        insert into trade_analysis
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="positionId != null">position_id,</if>
            <if test="createdAt != null">created_at,</if>
            <if test="updatedAt != null">updated_at,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="positionId != null">#{positionId},</if>
            <if test="createdAt != null">#{createdAt},</if>
            <if test="updatedAt != null">#{updatedAt},</if>
         </trim>
    </insert>

    <update id="updateTradeAnalysis" parameterType="TradeAnalysis">
        update trade_analysis
        <trim prefix="SET" suffixOverrides=",">
            <if test="positionId != null">position_id = #{positionId},</if>
            <if test="createdAt != null">created_at = #{createdAt},</if>
            <if test="updatedAt != null">updated_at = #{updatedAt},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteTradeAnalysisById" parameterType="Long">
        delete from trade_analysis where id = #{id}
    </delete>

    <delete id="deleteTradeAnalysisByIds" parameterType="String">
        delete from trade_analysis where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>